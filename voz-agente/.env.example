# ============================================================
# voz-agente — variables de entorno
# Copia este fichero a .env SOLO en local. Nunca cometas .env
# En producción (Fly.io): fly secrets set VAR=valor
# ============================================================

# -- Supabase --
SUPABASE_URL=https://tvkdhjxatkehuryvnjmu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# -- Vapi --
# El secreto HMAC que valida que el webhook viene de Vapi.
# Generar con: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=GENERAR_CON_OPENSSL_RAND_HEX_32

# -- Cifrado teléfonos --
# AES-GCM 256 bits. Generar con: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=GENERAR_CON_OPENSSL_RAND_HEX_32

# -- Google Calendar --
# Service account JSON completo como string (o ruta a fichero local en dev)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# O en local apuntar a fichero:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-sa.json

# -- Servidor --
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# -- Timezone default --
TZ=Atlantic/Canary
